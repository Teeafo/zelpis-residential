<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="Zelpis Residential offers comfortable, affordable shared living for adults in Fort Walton Beach, Okaloosa County, Florida." />
    <link rel="icon" href="data:," />
    <title>Zelpis Residential — Comfortable, Affordable Shared Living | Fort Walton Beach, FL</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --navy: #142e4a;
        --navy-deep: #0e2238;
        --navy-soft: #1e3d5e;
        --gold: #b9975b;
        --gold-light: #d6bc84;
        --bg: #ffffff;
        --bg-alt: #f4f6f8;
        --surface: #ffffff;
        --ink: #1a2b3d;
        --ink-soft: #4a5d70;
        --line: #dde3e8;
        --on-navy: #ffffff;
        --on-navy-soft: #cdd8e4;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0e2238;
          --bg-alt: #122a45;
          --surface: #162e4a;
          --ink: #eef2f6;
          --ink-soft: #b8c6d4;
          --line: #2a4560;
          --gold: #c9a86a;
          --gold-light: #d6bc84;
        }
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Public Sans", system-ui, -apple-system, sans-serif;
        font-size: 17px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3 { font-family: "Fraunces", Georgia, serif; font-weight: 600; line-height: 1.15; margin: 0; color: var(--navy); }
      @media (prefers-color-scheme: dark) { h1, h2, h3 { color: var(--ink); } }
      p { margin: 0; }
      a { color: var(--navy); }
      @media (prefers-color-scheme: dark) { a { color: var(--gold-light); } }
      .wrap { max-width: 880px; margin: 0 auto; padding: 0 24px; }
      .wrap-wide { max-width: 1040px; margin: 0 auto; padding: 0 24px; }

      /* Buttons */
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        text-decoration: none; font-weight: 600; font-size: 1rem;
        padding: 13px 26px; border-radius: 8px; border: 1.5px solid transparent;
        transition: background 0.15s ease, border-color 0.15s ease;
        min-height: 48px;
      }
      .btn-gold { background: var(--gold); color: #142e4a; border-color: var(--gold); }
      .btn-gold:hover { background: var(--gold-light); border-color: var(--gold-light); }
      .btn-outline-light { background: transparent; color: #fff; border-color: rgba(255,255,255,0.7); }
      .btn-outline-light:hover { border-color: #fff; background: rgba(255,255,255,0.08); }
      .btn-navy { background: var(--navy); color: #fff; border-color: var(--navy); }
      @media (prefers-color-scheme: dark) { .btn-navy { background: var(--gold); color: #142e4a; border-color: var(--gold); } }
      .btn-outline-navy { background: transparent; color: var(--navy); border-color: var(--navy); }
      @media (prefers-color-scheme: dark) { .btn-outline-navy { color: var(--ink); border-color: var(--ink-soft); } }
      .btn-row { display: flex; flex-wrap: wrap; gap: 12px; }
      @media (max-width: 520px) { .btn-row .btn { flex: 1 1 100%; } }

      /* 1. Hero */
      .hero { background: var(--navy-deep); color: var(--on-navy); padding: 56px 0 64px; }
      .hero-brand { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-bottom: 48px; }
      .hero-brand .logo { display: block; width: 190px; max-width: 55vw; height: auto; }
      .hero-photo { display: block; width: 100%; height: auto; border-radius: 10px; margin-top: 40px; }
      .hero-brand .area { font-size: 0.9rem; color: var(--on-navy-soft); font-weight: 500; }
      .hero-rule { width: 48px; height: 3px; background: var(--gold); border: none; margin: 0 0 24px; }
      .hero h1 { color: #fff; font-size: clamp(2.3rem, 5.5vw, 3.4rem); max-width: 16ch; margin-bottom: 20px; }
      .hero p { color: var(--on-navy-soft); font-size: 1.13rem; max-width: 38rem; margin-bottom: 32px; }

      /* Sections */
      section { padding: 64px 0; }
      section.alt { background: var(--bg-alt); }
      .kicker { font-size: 0.82rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; color: var(--gold); margin-bottom: 12px; }
      @media (prefers-color-scheme: dark) { .kicker { color: var(--gold-light); } }
      section h2 { font-size: clamp(1.8rem, 3.5vw, 2.3rem); margin-bottom: 16px; }
      section .body-text { color: var(--ink-soft); font-size: 1.06rem; max-width: 44rem; }
      section .body-text + .body-text { margin-top: 14px; }

      /* About photo strip */
      .photo-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 32px; }
      .photo-strip img { display: block; width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; }
      @media (max-width: 520px) { .photo-strip { gap: 10px; } }

      /* What to expect */
      .expect-list { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px 28px; max-width: 52rem; }
      .expect-list li { display: flex; gap: 12px; align-items: flex-start; color: var(--ink-soft); font-size: 1.02rem; }
      .expect-list .dot { flex: 0 0 auto; width: 8px; height: 8px; border-radius: 50%; background: var(--gold); margin-top: 9px; }
      @media (max-width: 640px) { .expect-list { grid-template-columns: 1fr; } }

      /* Steps */
      .steps { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
      .steps li { border-top: 3px solid var(--gold); padding-top: 18px; }
      .steps .num { font-family: "Fraunces", Georgia, serif; font-size: 1.9rem; font-weight: 600; color: var(--navy); line-height: 1; display: block; margin-bottom: 10px; }
      @media (prefers-color-scheme: dark) { .steps .num { color: var(--gold-light); } }
      .steps h3 { font-size: 1.08rem; font-family: "Public Sans", system-ui, sans-serif; font-weight: 700; margin-bottom: 6px; }
      .steps p { color: var(--ink-soft); font-size: 0.98rem; }
      @media (max-width: 720px) { .steps { grid-template-columns: 1fr; gap: 22px; } }

      /* Referral partners */
      .referral { background: var(--navy); color: var(--on-navy); }
      .referral h2 { color: #fff; }
      .referral .kicker { color: var(--gold-light); }
      .referral p { color: var(--on-navy-soft); font-size: 1.06rem; max-width: 44rem; margin-bottom: 28px; }

      /* Contact */
      .contact-details { display: grid; gap: 6px; margin: 24px 0 28px; font-size: 1.06rem; }
      .contact-details dt { font-size: 0.82rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); margin-top: 14px; }
      @media (prefers-color-scheme: dark) { .contact-details dt { color: var(--gold-light); } }
      .contact-details dd { margin: 0; color: var(--ink); font-weight: 500; }
      .contact-details dd a { color: var(--ink); text-decoration: none; }
      .contact-details dd a:hover { text-decoration: underline; }

      /* Footer */
      footer { background: var(--navy-deep); color: var(--on-navy-soft); padding: 40px 0 44px; }
      footer .foot-logo { display: block; width: 132px; height: auto; margin-bottom: 14px; }
      footer p { font-size: 0.94rem; margin-bottom: 8px; }
      footer a { color: var(--on-navy-soft); }
      footer a:hover { color: #fff; }
      footer .foot-note { border-top: 1px solid rgba(255,255,255,0.18); margin-top: 20px; padding-top: 18px; font-size: 0.9rem; max-width: 44rem; }
    </style>
  </head>
  <body>
    <main>
      <!-- 1. HOME / HERO -->
      <div class="hero">
        <div class="wrap-wide">
          <div class="hero-brand">
            <img class="logo" src="data:image/png;base64," alt="Zelpis Residential" width="880" height="712" />
            <p class="area">Fort Walton Beach &middot; Okaloosa County, Florida</p>
          </div>
          <hr class="hero-rule" />
          <h1>Comfortable, Affordable Shared Living</h1>
          <p>Zelpis Residential offers a welcoming shared living housing option for adults looking for an affordable place to live in Fort Walton Beach and the surrounding Okaloosa County area.</p>
          <div class="btn-row">
            <a class="btn btn-gold" href="tel:9459001191">Call Us</a>
            <a class="btn btn-outline-light" href="mailto:info@zelpisresidential.com">Email Us</a>
          </div>
          <img class="hero-photo" src="data:image/jpeg;base64," alt="Three Zelpis Residential residents smiling together" width="933" height="648" />
        </div>
      </div>

      <!-- 2. ABOUT US -->
      <section id="about" aria-labelledby="about-heading">
        <div class="wrap">
          <p class="kicker">About Us</p>
          <h2 id="about-heading">A respectful place to live</h2>
          <p class="body-text">Zelpis Residential focuses on providing a respectful shared living environment where residents can feel comfortable and connected. We believe that a clear, straightforward housing experience starts with helpful communication and shared expectations.</p>
          <div class="photo-strip">
            <img src="data:image/jpeg;base64," alt="A bedroom at Zelpis Residential" width="355" height="258" loading="lazy" />
            <img src="data:image/jpeg;base64," alt="The laundry room at Zelpis Residential" width="354" height="257" loading="lazy" />
            <img src="data:image/jpeg;base64," alt="The kitchen at Zelpis Residential" width="349" height="258" loading="lazy" />
          </div>
        </div>
      </section>

      <!-- 3. WHO WE SERVE -->
      <section id="who-we-serve" class="alt" aria-labelledby="who-heading">
        <div class="wrap">
          <p class="kicker">Who We Serve</p>
          <h2 id="who-heading">Adults seeking affordable shared housing</h2>
          <p class="body-text">We welcome inquiries from adults exploring shared housing and from families, case managers, social workers, and community organizations helping people find housing options. Contact us to ask about current availability, house expectations, and whether our housing may be a fit.</p>
        </div>
      </section>

      <!-- 4. WHAT TO EXPECT -->
      <section id="what-to-expect" aria-labelledby="expect-heading">
        <div class="wrap">
          <p class="kicker">What to Expect</p>
          <h2 id="expect-heading">Shared living, kept simple</h2>
          <ul class="expect-list">
            <li><span class="dot" aria-hidden="true"></span><span>Shared living arrangements</span></li>
            <li><span class="dot" aria-hidden="true"></span><span>A home with shared spaces</span></li>
            <li><span class="dot" aria-hidden="true"></span><span>Basic house expectations designed to support a respectful living environment</span></li>
            <li><span class="dot" aria-hidden="true"></span><span>An opportunity to discuss availability and next steps</span></li>
          </ul>
        </div>
      </section>

      <!-- 5. HOW TO GET STARTED -->
      <section id="get-started" class="alt" aria-labelledby="started-heading">
        <div class="wrap-wide">
          <p class="kicker">How to Get Started</p>
          <h2 id="started-heading">Three simple steps</h2>
          <ol class="steps">
            <li>
              <span class="num" aria-hidden="true">1</span>
              <h3>Call or email us</h3>
              <p>Reach out by phone or email to start the conversation.</p>
            </li>
            <li>
              <span class="num" aria-hidden="true">2</span>
              <h3>Ask your questions</h3>
              <p>Ask about availability, costs, location, and house expectations.</p>
            </li>
            <li>
              <span class="num" aria-hidden="true">3</span>
              <h3>Discuss next steps</h3>
              <p>Discuss next steps and any screening or agreement required before moving in.</p>
            </li>
          </ol>
        </div>
      </section>

      <!-- 6. REFERRAL PARTNERS -->
      <section id="referral-partners" class="referral" aria-labelledby="referral-heading">
        <div class="wrap">
          <p class="kicker">Referral Partners</p>
          <h2 id="referral-heading">Helping someone find housing?</h2>
          <p>Are you a case manager, social worker, discharge planner, or community organization helping someone explore housing? Reach out to learn about our shared living option and whether it may be appropriate for the person you are assisting.</p>
          <div class="btn-row">
            <a class="btn btn-gold" href="tel:9459001191">Call Us</a>
            <a class="btn btn-outline-light" href="mailto:info@zelpisresidential.com">Email Us</a>
          </div>
        </div>
      </section>

      <!-- 7. CONTACT -->
      <section id="contact" aria-labelledby="contact-heading">
        <div class="wrap">
          <p class="kicker">Contact</p>
          <h2 id="contact-heading">Get in touch</h2>
          <dl class="contact-details">
            <dt>Business</dt>
            <dd>Zelpis Residential</dd>
            <dt>Phone</dt>
            <dd><a href="tel:9459001191">(945) 900-1191</a></dd>
            <dt>Email</dt>
            <dd><a href="mailto:info@zelpisresidential.com">info@zelpisresidential.com</a></dd>
            <dt>Service area</dt>
            <dd>Fort Walton Beach, Okaloosa County, Florida</dd>
          </dl>
          <div class="btn-row">
            <a class="btn btn-navy" href="tel:9459001191">Call (945) 900-1191</a>
            <a class="btn btn-outline-navy" href="mailto:info@zelpisresidential.com">Email Us</a>
          </div>
        </div>
      </section>
    </main>

    <!-- 8. FOOTER -->
    <footer>
      <div class="wrap-wide">
        <img class="foot-logo" src="data:image/png;base64," alt="Zelpis Residential" width="880" height="712" loading="lazy" />
        <p>Fort Walton Beach, Okaloosa County, Florida</p>
        <p><a href="tel:9459001191">(945) 900-1191</a> &middot; <a href="mailto:info@zelpisresidential.com">info@zelpisresidential.com</a></p>
        <p class="foot-note">Housing availability and terms change and must be confirmed directly with Zelpis Residential. Please call or email us for current information.</p>
      </div>
    </footer>
  </body>
</html>
